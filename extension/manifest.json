{
  "manifest_version": 3,
  "name": "Read Aloud Desktop Bridge V3",
  "description": "Desktop reading with a tray icon, fading pill, sizes, position lock and optional text cleanup.",
  "version": "3.1.0",
  "externally_connectable": { "ids": ["hfkpfdkphilnihhgbmcdepgecbmnemhf"] },
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
